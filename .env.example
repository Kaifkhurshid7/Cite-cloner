# Provider: anthropic | openai | offline  (offline = heuristic generator, no API key needed)
# Leave empty to auto-detect from the API key you set below (falls back to offline)
LLM_PROVIDER=

ANTHROPIC_API_KEY=
# Main model (vision + codegen) and fast model (planning edits, repairs)
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini

# Cache identical LLM calls on disk (.cache/llm) – re-runs cost $0
LLM_CACHE=true
# Hard stop per job, in USD
MAX_COST_USD=3
# Parallel section-generation calls
CONCURRENCY=4
PORT=4000
